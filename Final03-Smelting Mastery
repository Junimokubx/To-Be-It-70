items = {
    "Raw Porkchop": ("Food", 10),
    "Wood": ("General", 10),
    "Clay": ("General", 15),
    "Iron Ore": ("Ore", 20),
    "Raw Chicken": ("Food", 10),
    "Copper Ore": ("Ore", 15),
}

item = input().strip()
furnace = input().strip()

if item not in items:
    print("This item is not in your inventory.")
else:
    item_type, t = items[item]
    if furnace == "Furnace":
        print(f"The burning process took {t / 1.0:.2f} seconds.")
    elif furnace == "Smoker" and item_type == "Food":
        print(f"The burning process took {t / 2.0:.2f} seconds.")
    elif furnace == "Blast Furnace" and item_type == "Ore":
        print(f"The burning process took {t / 2.0:.2f} seconds.")
    else:
        print("This item cannot be smelted in this furnace.")