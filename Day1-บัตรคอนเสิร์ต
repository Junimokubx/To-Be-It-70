zone = input().strip().upper()
qty = int(input())
early_bird = input().strip().upper()

if zone == "VIP":
    price = 6000
elif zone == "A":
    price = 4500
elif zone == "B":
    price = 2500
else:
    price = 0

if price == 0:
    print("Invalid Zone")
else:
    total = price * qty
    if early_bird == "Y":
        total = total * 0.90
    if qty > 4:
        total = total - 500
    print(f"{total:.2f}")